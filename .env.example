# Tracelyt Telemetry Pipeline - Environment Configuration Template
# COPY THIS FILE TO .env FOR LOCAL OVERRIDES (NEVER COMMIT .env TO VERSION CONTROL)

# Runtime Environment Profile (e.g., local, dev, prod)
SPRING_PROFILES_ACTIVE=local

# Application Service Port (Default: 8082 for Pipeline service)
SERVER_PORT=8082

# Diagnostic & Logging Level (TRACE, DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL_IO_TRACELYT_PIPELINE=INFO

# Management & Health Endpoint Security
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
